# No mostrar el listado de archivos de las carpetas
Options -Indexes

# Páginas de error propias (403, 404 y 500).
# La ruta empieza en la raíz del sitio: si el proyecto no está en /bancoAurea, ajústela.
ErrorDocument 403 /bancoAurea/public/error.php
ErrorDocument 404 /bancoAurea/public/error.php
ErrorDocument 500 /bancoAurea/public/error.php

# Cabeceras de seguridad (requieren mod_headers)
<IfModule mod_headers.c>
    # Evita que la página se abra dentro de un iframe de otro sitio (clickjacking)
    Header always set X-Frame-Options "DENY"
    # El navegador no debe adivinar el tipo de archivo
    Header always set X-Content-Type-Options "nosniff"
    # No enviar la URL completa a otros sitios
    Header always set Referrer-Policy "same-origin"
    # Solo se permite cargar recursos del propio sitio
    # ('unsafe-inline' porque las páginas tienen scripts y estilos dentro del HTML)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
</IfModule>
